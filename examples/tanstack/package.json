{
  "name": "convex-better-auth-tanstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "vite dev --port 3000",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../tsconfig*.json' '../../src/**/*.ts' '../../src/**/*.tsx' -i '**/*.test.ts' -c 'pnpm run build' --initial",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "build": "convex codegen --component-dir ../../src/component && cd ../../ && pnpm run build",
    "lint": "prettier --check '**/*' --ignore-unknown && eslint --ext .ts,.tsx ./app",
    "format": "prettier --write '**/*' --ignore-unknown"
  },
  "dependencies": {
    "@convex-dev/better-auth": "workspace:@helixnebulatech/convex-better-auth@*",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/resend": "^0.2.8",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "dotenv": "^18.0.5",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.0",
    "react-qr-code": "^2.2.0",
    "redaxios": "^0.5.1",
    "resend": "^6.31.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "~10.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
