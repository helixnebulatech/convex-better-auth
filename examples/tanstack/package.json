{
  "name": "convex-better-auth-tanstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "vite dev --port 3000",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../packages/convex-better-auth/tsconfig*.json' '../../packages/convex-better-auth/src/**/*.ts' '../../packages/convex-better-auth/src/**/*.tsx' -i '**/*.test.ts' -c 'bun run build' --initial",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "build": "convex codegen --component-dir ../../packages/convex-better-auth/src/component && cd ../../packages/convex-better-auth && bun run build",
    "check-types": "tsc --noEmit -p . && tsc --noEmit -p convex"
  },
  "dependencies": {
    "@convex-dev/better-auth": "workspace:@helixnebulatech/convex-better-auth@*",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/resend": "^0.2.10",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/render": "^2.2.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.49.0",
    "convex-helpers": "^0.1.134",
    "dotenv": "^18.0.9",
    "http-proxy-middleware": "^4.2.1",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.7",
    "react-qr-code": "^2.2.0",
    "redaxios": "^0.5.1",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "~10.0.6",
    "npm-run-all": "^4.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
