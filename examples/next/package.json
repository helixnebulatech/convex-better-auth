{
  "name": "example-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "next dev --webpack --experimental-https",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../packages/convex-better-auth/tsconfig*.json' '../../packages/convex-better-auth/src/**/*.ts' '../../packages/convex-better-auth/src/**/*.tsx' -i '**/*.test.ts' -c 'bun run build' --initial",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "build": "convex codegen --component-dir ../../packages/convex-better-auth/src/component && cd ../../packages/convex-better-auth && bun run build",
    "check-types": "tsc --noEmit -p . && tsc --noEmit -p convex"
  },
  "dependencies": {
    "@convex-dev/better-auth": "workspace:@helixnebulatech/convex-better-auth@*",
    "@convex-dev/resend": "^0.2.10",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/render": "^2.2.0",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.49.0",
    "convex-helpers": "^0.1.134",
    "http-proxy-middleware": "^4.2.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.7",
    "react-qr-code": "^2.2.0",
    "resend": "^6.37.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.35",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
