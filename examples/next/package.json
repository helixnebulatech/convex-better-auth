{
  "name": "example-next",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "next dev --webpack --experimental-https",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../tsconfig*.json' '../../src/**/*.ts' '../../src/**/*.tsx' -i '**/*.test.ts' -c 'pnpm run build' --initial",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "build": "convex codegen --component-dir ../../src/component && cd ../../ && pnpm run build",
    "lint": "next lint && tsc -p convex && eslint convex"
  },
  "dependencies": {
    "@convex-dev/better-auth": "workspace:@helixnebulatech/convex-better-auth@*",
    "@convex-dev/resend": "^0.2.8",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/render": "^2.1.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "^0.1.124",
    "http-proxy-middleware": "^4.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "react-qr-code": "^2.2.0",
    "resend": "^6.31.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "baseline-browser-mapping": "^2.11.26",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
