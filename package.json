{
  "name": "@helixnebulatech/convex-better-auth",
  "description": "Fork of @convex-dev/better-auth that tracks the latest Better Auth release.",
  "repository": "github:helixnebulatech/convex-better-auth",
  "homepage": "https://github.com/helixnebulatech/convex-better-auth#readme",
  "bugs": {
    "url": "https://github.com/helixnebulatech/convex-better-auth/issues"
  },
  "version": "0.13.0",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "convex",
    "component",
    "auth",
    "authentication",
    "better-auth",
    "convex-auth"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm --dir examples/react run dev",
    "build": "tsc --project tsconfig.build.json",
    "build:codegen": "cd examples/react && pnpm exec convex codegen --component-dir ../../src/component && cd ../.. && pnpm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p examples/next && tsc -p examples/next/convex && tsc -p examples/react && tsc -p examples/react/convex && tsc -p examples/tanstack && tsc -p examples/tanstack/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm run build && pnpm --dir e2e run test",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "changeset": "changeset",
    "ci:version": "changeset version && node scripts/sync-version.mjs && prettier -w CHANGELOG.md",
    "ci:release": "rm -rf dist *.tsbuildinfo && pnpm run build && changeset publish"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./adapter": {
      "types": "./dist/component/adapter.d.ts",
      "default": "./dist/component/adapter.js"
    },
    "./auth-config": {
      "types": "./dist/auth-config.d.ts",
      "default": "./dist/auth-config.js"
    },
    "./client/plugins": {
      "types": "./dist/client/plugins/index.d.ts",
      "default": "./dist/client/plugins/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "default": "./dist/nextjs/index.js"
    },
    "./nextjs/client": {
      "types": "./dist/nextjs/client.d.ts",
      "default": "./dist/nextjs/client.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react-start": {
      "types": "./dist/react-start/index.d.ts",
      "default": "./dist/react-start/index.js"
    },
    "./test": "./src/test.ts",
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "next-js": [
        "./dist/nextjs/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "better-auth": ">=1.7.5 <1.8.0",
    "convex": "^1.25.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/test-utils": "1.7.7",
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@tanstack/react-start": "1.168.57",
    "@types/common-tags": "1.8.4",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "@types/semver": "7.8.0",
    "better-auth": "1.7.7",
    "chokidar-cli": "3.0.0",
    "concurrently": "10.0.5",
    "convex": "1.46.0",
    "convex-test": "0.0.59",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "next": "16.3.6",
    "pkg-pr-new": "0.0.88",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "dependencies": {
    "@better-fetch/fetch": "^1.1.18",
    "common-tags": "^1.8.2",
    "convex-helpers": "^0.1.95",
    "jose": "^6.1.0",
    "remeda": "^2.32.0",
    "semver": "^7.7.3",
    "type-fest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
